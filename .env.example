# Required
TELEGRAM_BOT_TOKEN=

# Optional (defaults shown)
# USE_LAMA=false                 # true = better quality, needs ~1.5 GB RAM, downloads a ~200 MB model once
# LAMA_MODEL_PATH=models/lama_fp32.onnx
# MAX_IMAGE_MB=15
# MAX_MEGAPIXELS=40
# MAX_CONCURRENT_JOBS=2
# JOB_TIMEOUT_SECONDS=120
# SESSION_TTL_SECONDS=900
# AUTO_CROP_SCREENSHOT_BORDERS=true
# OUTPUT_QUALITY=95
# OCR_MAX_SIDE=1600
# LOG_LEVEL=INFO
# PORT=                          # set automatically by some hosts; enables a /health endpoint
